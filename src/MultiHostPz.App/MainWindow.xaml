<Window x:Class="MultiHostPz.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiHost PZ"
        Height="500"
        Width="760"
        MinHeight="360"
        MinWidth="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="MultiHost PZ" />
            <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" Foreground="#666666" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="LanguageLabelText" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageSelector" Width="120" SelectionChanged="LanguageSelector_SelectionChanged">
                <ComboBoxItem Tag="en" Content="English" />
                <ComboBoxItem Tag="es" Content="Español" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="ProfileRootHeadingText" FontWeight="SemiBold" />
            <TextBlock x:Name="ProfileRootText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock x:Name="SavesPathHeadingText" FontWeight="SemiBold" />
            <TextBlock x:Name="MultiplayerSavesPathText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <TextBlock x:Name="ProfileExistsLabelText" Margin="0,0,4,0" FontWeight="SemiBold" />
            <TextBlock x:Name="ProfileRootStatusText" />
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal">
            <Button x:Name="CreateSnapshotButton" Width="180"
                     Click="CreateSnapshotButton_Click"
                    />
            <Button x:Name="RestoreSnapshotButton" Margin="12,0,0,0"
                    Width="210"
                     Click="RestoreLatestSnapshotButton_Click"
                    />
        </StackPanel>

        <Border Grid.Row="12" Padding="14" Background="#FFF3E0" BorderBrush="#F0B35A" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="SnapshotStatusHeadingText" FontWeight="SemiBold" />
                <TextBlock x:Name="SnapshotStatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SyncStatusHeadingText" Margin="0,12,0,0" FontWeight="SemiBold" />
                <TextBlock x:Name="SyncStatusText" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
