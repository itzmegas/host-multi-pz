<Window x:Class="MultiHostPz.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="MultiHost PZ"
         Height="680"
         Width="760"
         MinHeight="620"
         MinWidth="680"
         Background="{StaticResource WindowBackgroundBrush}"
         Foreground="{StaticResource TextPrimaryBrush}"
         FontFamily="Segoe UI"
         WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
             <RowDefinition Height="Auto" />
             <RowDefinition Height="12" />
             <RowDefinition Height="Auto" />
             <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="MultiHost PZ" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,20,0" Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="LanguageLabelText"
                           Margin="2,0,0,5"
                           Style="{StaticResource CardHeadingTextStyle}" />
                <ComboBox x:Name="LanguageSelector"
                          Width="132"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="LanguageSelector_SelectionChanged">
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="es" Content="Español" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="ProfileRootHeadingText" Style="{StaticResource CardHeadingTextStyle}" />
                    <TextBlock x:Name="ProfileRootText" Margin="0,5,0,0" Style="{StaticResource ValueTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="ProfileExistsLabelText" Margin="0,0,4,0" Style="{StaticResource CardHeadingTextStyle}" />
                        <TextBlock x:Name="ProfileRootStatusText" Style="{StaticResource ValueTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="{StaticResource CardBorderBrush}" />
                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock x:Name="SavesPathHeadingText" Style="{StaticResource CardHeadingTextStyle}" />
                    <TextBlock x:Name="MultiplayerSavesPathText" Margin="0,5,0,0" Style="{StaticResource ValueTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CreateSnapshotButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CreateSnapshotButton_Click" />
                <Button x:Name="RestoreSnapshotButton"
                        Grid.Column="2"
                        Style="{StaticResource RestoreButtonStyle}"
                        Click="RestoreLatestSnapshotButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                <Grid Grid.Column="1" Margin="14,0,0,0">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SnapshotStatusHeadingText" Style="{StaticResource SectionHeadingTextStyle}" />
                        <TextBlock x:Name="SnapshotStatusText" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                     </StackPanel>
                     <ProgressBar x:Name="LocalOperationProgress"
                                  Grid.Row="1"
                                  Margin="0,10,0,0"
                                  Style="{StaticResource IndeterminateProgressStyle}"
                                  Visibility="Collapsed" />
                     <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="SyncStatusHeadingText" Style="{StaticResource CardHeadingTextStyle}" />
                        <TextBlock x:Name="SyncStatusText" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="8" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock x:Name="CloudHeadingText" Style="{StaticResource SectionHeadingTextStyle}" />
                <StackPanel Margin="0,8,0,10" Orientation="Horizontal">
                    <TextBlock x:Name="CloudProviderLabelText" Width="150" VerticalAlignment="Center" Style="{StaticResource CardHeadingTextStyle}" />
                    <ComboBox x:Name="CloudProviderSelector" Width="170" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CloudProviderSelector_SelectionChanged">
                        <ComboBoxItem Tag="google-drive" Content="Google Drive" />
                        <ComboBoxItem Tag="dropbox" Content="Dropbox" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="CloudStatusText" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button x:Name="CloudConnectButton" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="CloudConnectButton_Click" />
                    <Button x:Name="CloudUploadButton" Margin="0,0,8,8" Style="{StaticResource RestoreButtonStyle}" Click="CloudUploadButton_Click" />
                    <Button x:Name="CloudDownloadButton" Margin="0,0,8,8" Style="{StaticResource RestoreButtonStyle}" Click="CloudDownloadButton_Click" />
                    <Button x:Name="CloudDisconnectButton" Margin="0,0,0,8" Style="{StaticResource RestoreButtonStyle}" Click="CloudDisconnectButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
