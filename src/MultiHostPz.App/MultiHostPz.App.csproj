<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MultiHostPz</AssemblyName>
    <RootNamespace>MultiHostPz.App</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>MultiHostPz</Product>
    <GoogleClientSecretsPath Condition="'$(GoogleClientSecretsPath)' == ''">$(MSBuildProjectDirectory)\..\..\env\google-client-secrets.json</GoogleClientSecretsPath>
    <GoogleClientSecretsPath Condition="'$(GoogleClientSecretsPath)' == '$(MSBuildProjectDirectory)\..\..\env\google-client-secrets.json' and '$(MULTIHOSTPZ_GOOGLE_CLIENT_SECRETS_PATH)' != ''">$(MULTIHOSTPZ_GOOGLE_CLIENT_SECRETS_PATH)</GoogleClientSecretsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="$(GoogleClientSecretsPath)" LogicalName="MultiHostPz.App.google-client-secrets.json" Condition="Exists('$(GoogleClientSecretsPath)')" />
  </ItemGroup>

</Project>
